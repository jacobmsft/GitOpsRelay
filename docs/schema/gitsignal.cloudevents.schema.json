{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jacobmsft/GitOpsRelay/blob/main/docs/schema/gitsignal.cloudevents.schema.json",
  "title": "GitOpsRelay GitSignal",
  "description": "A GitOpsRelay signal using the CloudEvents 1.0 JSON envelope.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "idempotencykey", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "io.gitopsrelay.git.push",
        "io.gitopsrelay.git.branch.created",
        "io.gitopsrelay.git.branch.deleted",
        "io.gitopsrelay.git.tag.created",
        "io.gitopsrelay.git.tag.deleted",
        "io.gitopsrelay.git.pr.opened",
        "io.gitopsrelay.git.pr.updated",
        "io.gitopsrelay.git.pr.merged",
        "io.gitopsrelay.git.pr.closed"
      ]
    },
    "subject": { "type": "string", "pattern": "^(refs/(heads|tags)/.+|pr/[1-9][0-9]*)$" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "type": "string" },
    "idempotencykey": { "type": "string", "pattern": "^v1-[0-9a-f]{64}$" },
    "targetref": { "type": "string", "pattern": "^refs/heads/.+" },
    "data": { "$ref": "#/$defs/data" }
  },
  "patternProperties": {
    "^(?!specversion$|id$|source$|type$|subject$|time$|datacontenttype$|dataschema$|idempotencykey$|targetref$|data$)[a-z][a-z0-9]{0,19}$": {
      "description": "CloudEvents extension attribute, for example traceparent or tracestate.",
      "type": ["string", "integer", "number", "boolean"]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "pattern": "\\.pr\\." } }, "required": ["type"] },
      "then": {
        "required": ["targetref"],
        "properties": {
          "subject": { "pattern": "^pr/[1-9][0-9]*$" },
          "data": {
            "required": ["repository", "ingestion", "pullRequest"],
            "not": { "required": ["change"] }
          }
        }
      },
      "else": {
        "properties": {
          "subject": { "pattern": "^refs/(heads|tags)/.+" },
          "data": {
            "required": ["repository", "ingestion", "change"],
            "not": { "required": ["pullRequest"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["io.gitopsrelay.git.branch.created", "io.gitopsrelay.git.tag.created"] } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "properties": { "change": { "properties": { "beforeSha": { "const": null } } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["io.gitopsrelay.git.branch.deleted", "io.gitopsrelay.git.tag.deleted"] } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "properties": { "change": { "properties": { "afterSha": { "const": null } } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["io.gitopsrelay.git.branch.created", "io.gitopsrelay.git.branch.deleted"] } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": { "properties": { "change": { "properties": { "refType": { "const": "branch" } } } } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["io.gitopsrelay.git.tag.created", "io.gitopsrelay.git.tag.deleted"] } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "change": { "properties": { "refType": { "const": "tag" } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["io.gitopsrelay.git.pr.opened", "io.gitopsrelay.git.pr.updated"] } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "pullRequest": { "properties": { "status": { "const": "open" } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "io.gitopsrelay.git.pr.merged" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "pullRequest": { "properties": { "status": { "const": "merged" } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "io.gitopsrelay.git.pr.closed" } }, "required": ["type"] },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "pullRequest": { "properties": { "status": { "const": "closed" } } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "required": ["repository", "ingestion"],
      "properties": {
        "repository": {
          "type": "object",
          "required": ["provider", "host", "name", "cloneUrl", "canonicalId"],
          "properties": {
            "provider": { "enum": ["github", "azdo", "git"] },
            "host": { "type": "string", "minLength": 1 },
            "owner": { "type": "string" },
            "project": { "type": "string" },
            "name": { "type": "string", "minLength": 1 },
            "cloneUrl": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:https?://[^/@?#\\s]+/[^?#\\s]+|ssh://(?:[A-Za-z0-9._-]+@)?[^/@?#:\\s]+(?::[0-9]+)?/[^?#\\s]+|(?!(?:https?|ssh|file):)(?:[A-Za-z0-9._-]+@)?[^@/:?#\\s]+:[^@?#\\s]+)$",
              "description": "Credential-free HTTPS or SCP-style SSH clone URL."
            },
            "defaultBranch": { "type": ["string", "null"] },
            "canonicalId": { "type": "string", "pattern": "^[^/]+/.+$" }
          },
          "additionalProperties": false
        },
        "ingestion": {
          "type": "object",
          "required": ["mode", "observedAt"],
          "properties": {
            "mode": { "enum": ["webhook", "poll"] },
            "observedAt": { "type": "string", "format": "date-time" },
            "rawDeliveryId": { "type": "string" }
          },
          "additionalProperties": false
        },
        "change": {
          "type": "object",
          "required": ["ref", "refType", "beforeSha", "afterSha"],
          "properties": {
            "ref": { "type": "string", "pattern": "^refs/(heads|tags)/.+" },
            "refType": { "enum": ["branch", "tag"] },
            "beforeSha": { "type": ["string", "null"], "pattern": "^(?!0{40}$|0{64}$)(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
            "afterSha": { "type": ["string", "null"], "pattern": "^(?!0{40}$|0{64}$)(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
            "isForcePush": { "type": ["boolean", "null"] },
            "changedPaths": { "type": "array", "items": { "type": "string" } },
            "actor": { "type": "string" }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "refType": { "const": "branch" } }, "required": ["refType"] },
              "then": { "properties": { "ref": { "pattern": "^refs/heads/.+" } } },
              "else": { "properties": { "ref": { "pattern": "^refs/tags/.+" } } }
            }
          ]
        },
        "pullRequest": {
          "type": "object",
          "required": ["id", "number", "title", "status", "isDraft", "sourceRef", "targetRef", "headSha"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "number": { "type": "integer", "minimum": 1 },
            "title": { "type": "string" },
            "status": { "enum": ["open", "closed", "merged"] },
            "isDraft": { "type": "boolean" },
            "sourceRef": { "type": "string", "pattern": "^refs/heads/.+" },
            "targetRef": { "type": "string", "pattern": "^refs/heads/.+" },
            "headSha": { "type": "string", "pattern": "^(?!0{40}$|0{64}$)(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
            "mergeCommitSha": { "type": ["string", "null"], "pattern": "^(?!0{40}$|0{64}$)(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
